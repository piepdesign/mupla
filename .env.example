# Copy to .env.local and fill in. .env.local is never committed.
# Ticketmaster Discovery API, https://developer-account.ticketmaster.com/
TICKETMASTER_API_KEY=
# Optional: Eventfrog Public API (festivals, parties, smaller venues), free key per account:
# https://eventfrog.ch/en/help/organizer/settings/api/api-keys.html
EVENTFROG_API_KEY=
# Last.fm API, https://www.last.fm/api/account/create
LASTFM_API_KEY=
# Your Last.fm username
LASTFM_USERNAME=
# Contact for the MusicBrainz / Nominatim User-Agent (e-mail or URL), required by their usage policies
CONTACT=
# Optional: home coordinate for distances (default Gießen 50.5841, 8.6784)
HOME_LAT=
HOME_LON=
